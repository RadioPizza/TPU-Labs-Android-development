<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/padding_standard"
    android:background="@color/background"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/game_title"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/primary"
        android:layout_marginTop="@dimen/margin_top_small"
        android:layout_marginBottom="@dimen/margin_bottom_large" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="@dimen/padding_standard"
        android:elevation="@dimen/elevation_standard"
        android:layout_marginBottom="@dimen/margin_bottom_medium">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_searching"
            android:textSize="@dimen/text_size_medium"
            android:gravity="center"
            android:textColor="@color/primary"
            android:layout_marginBottom="@dimen/margin_bottom_small" />

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/distance_unknown"
            android:textSize="@dimen/text_size_normal"
            android:gravity="center"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <Button
        android:id="@+id/btnNewPoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_new_point"
        android:textSize="@dimen/text_size_normal"
        android:backgroundTint="@color/primary"
        android:textColor="@android:color/white"
        android:layout_marginBottom="@dimen/margin_bottom_small"
        android:padding="@dimen/padding_small" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_settings"
        android:textSize="@dimen/text_size_normal"
        android:backgroundTint="@color/secondary"
        android:textColor="@android:color/white"
        android:padding="@dimen/padding_small" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hint_move"
        android:textSize="@dimen/text_size_small"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="@dimen/margin_top_medium" />

</LinearLayout>